# BACKEND_URL/PORT와 컨테이너의 DNS 주소는 시작 시점에 envsubst로 치환된다.
# (Dockerfile의 NGINX_ENVSUBST_FILTER가 이 세 변수만 치환 대상으로 제한한다.
#  $host, $remote_addr 같은 nginx 자체 변수는 필터 밖이라 그대로 유지된다.)
#
# 로컬 docker-compose: BACKEND_URL=http://backend:8000, PORT=80
# Cloud Run 등 배포 환경: BACKEND_URL=https://<백엔드 서비스 주소>, PORT는 런타임이 지정

# Caddy 같은 앞단 프록시가 전달한 원래 HTTPS 정보를 보존한다.
# 앞단 프록시 없이 직접 접근한 경우에는 현재 연결 방식($scheme)을 사용한다.
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 백엔드가 재시작해 IP가 바뀌어도 컨테이너의 DNS에서 다시 조회한다
    resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;
    resolver_timeout 2s;
    set $backend_url "${BACKEND_URL}";

    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;

    # 정적 코드와 모델만 압축한다 이미 압축된 그림/글꼴, API JSON은 제외한다
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_proxied any;
    gzip_types text/css application/javascript image/svg+xml model/gltf-binary;

    # 내용 해시가 바뀌는 Vite 청크는 오래 보관해도 새 배포와 섞이지 않는다
    location ~ "^/assets/[^/]+-[A-Za-z0-9_-]{8,}\\.(js|css)$" {
        try_files $uri =404;
        expires 365d;
    }

    # 원본 경로를 유지하는 그림/글꼴은 재검증해 변경된 디자인이 바로 반영된다
    location /assets/ {
        try_files $uri =404;
        expires -1;
    }

    location /models/ {
        types { model/gltf-binary glb; }
        try_files $uri =404;
        expires -1;
    }

    # React Router(SPA) — 새로고침/직접 URL 진입 시 index.html로 폴백
    location / {
        try_files $uri $uri/ /index.html;
    }

    # SPA 주소별로 오래된 HTML을 재사용해 이전 화면이 남지 않게 한다
    # expires는 서버의 보안 헤더 상속을 유지하면서 Cache-Control: no-cache를 설정한다
    location = /index.html {
        expires -1;
    }

    # Runtime이 사용하는 비밀값 조회 경로만 백엔드로 전달한다
    location = /internal/v1/runtime-secrets/resolve {
        client_max_body_size 16k;
        proxy_pass $backend_url$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_cache off;
        proxy_buffering off;
    }

    # 전용 VM 에이전트가 자기 문제의 설정과 적용 결과만 조회한다
    location ~ "^/internal/v1/koth_environments/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(/status)?$" {
        client_max_body_size 4k;
        proxy_pass $backend_url$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_cache off;
        proxy_buffering off;
    }
    location /internal/v1/koth_environments/ { return 404; }

    # KOTH 서버의 팀 인증과 팀 목록 조회도 플랫폼 백엔드로 전달한다
    location = /internal/koth/team_tokens/verify {
        client_max_body_size 4k;
        proxy_pass $backend_url$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Internal-Token $http_x_internal_token;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_cache off;
        proxy_buffering off;
    }

    location = /internal/teams {
        client_max_body_size 4k;
        proxy_pass $backend_url$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Internal-Token $http_x_internal_token;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_cache off;
        proxy_buffering off;
    }

    location /internal/ {
        return 404;
    }

    # SLA가 Django의 DB·Redis 점검 결과를 그대로 받을 수 있게 연결한다
    location = /healthz {
        proxy_pass $backend_url$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_cache off;
        proxy_intercept_errors off;
    }

    # 백엔드 API 프록시
    location /api/v1/ {
        proxy_pass $backend_url$request_uri;
        # BACKEND_URL이 https일 때 SNI를 보내야 하는 백엔드(Cloud Run 등)에 대응
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
    }
}
